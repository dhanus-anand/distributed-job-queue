# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
DATABASE_URL=postgresql://djq_user:djq_password@localhost:5432/djq_db

# PostgreSQL (for docker-compose)
POSTGRES_USER=djq_user
POSTGRES_PASSWORD=djq_password
POSTGRES_DB=djq_db

# Server
PORT=8080

# Worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=10
METRICS_PORT=9091

# Grafana
GRAFANA_PASSWORD=admin

# Job config
VISIBILITY_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=5
DLQ_RETENTION_DAYS=7
